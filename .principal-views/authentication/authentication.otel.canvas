        "stroke": "#1d4ed8",
        "dataSchema": {
          "authenticated": {
            "type": "boolean",
            "required": true
          }
        }
      }
    },
    {
      "id": "token-check-error",
      "type": "text",
      "text": "# Token Check Error\n\nError during token check",
      "x": 450,
      "y": 450,
      "width": 200,
      "height": 100,
      "color": "#dc2626",
      "pv": {
        "status": "implemented",
        "event": {
          "name": "token.check.error",
          "attributes": {
            "error.type": { "type": "string", "description": "Error type", "required": true },
            "error.message": { "type": "string", "description": "Error message", "required": true }
          }
        },
        "references": [
          "src/app/api/auth/token-status/route.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "error",
          "files": ["src/app/api/auth/token-status/route.ts"]
        },
        "shape": "rectangle",
        "fill": "#ef4444",
        "stroke": "#dc2626",
        "dataSchema": {
          "error.type": {
            "type": "string",
            "required": true
          },
          "error.message": {
            "type": "string",
            "required": true
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "started-to-authenticated",
      "fromNode": "token-check-started",
      "fromSide": "bottom",
      "toNode": "token-check-authenticated",
      "toSide": "top",
      "label": "valid token",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "started-to-authenticated-expiring",
      "fromNode": "token-check-started",
      "fromSide": "bottom",
      "toNode": "token-check-authenticated-expiring",
      "toSide": "top",
      "label": "valid token (expiring)",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "started-to-unauthenticated",
      "fromNode": "token-check-started",
      "fromSide": "right",
      "toNode": "token-check-unauthenticated",
      "toSide": "left",
      "label": "no token",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "started-to-error",
      "fromNode": "token-check-started",
      "fromSide": "right",
      "toNode": "token-check-error",
      "toSide": "left",
      "label": "exception",
      "pv": {
