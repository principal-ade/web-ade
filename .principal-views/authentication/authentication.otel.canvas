{
  "pv": {
    "name": "Token Status Check",
    "version": "1.0.0",
    "markdown": ".principal-views/authentication/authentication.md",
    "edgeTypes": {
      "flow": {
        "label": "Flow"
      },
      "error": {
        "label": "Error Path"
      }
    }
  },
  "nodes": [
    {
      "id": "token-check-started",
      "type": "text",
      "text": "# Token Check Started\n\nToken status request received",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "pv": {
        "status": "implemented",
        "event": {
          "name": "token.check.started",
          "attributes": {
            "request.timestamp": { "type": "number", "description": "Request timestamp", "required": true }
          }
        },
        "references": [
          "src/app/api/auth/token-status/route.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": ["src/app/api/auth/token-status/route.ts"]
        },
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a",
        "dataSchema": {
          "request.timestamp": {
            "type": "number",
            "required": true
          }
        }
      }
    },
    {
      "id": "token-check-authenticated",
      "type": "text",
      "text": "# Authenticated\n\nValid token found - authenticated",
      "x": 100,
      "y": 250,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "pv": {
        "status": "implemented",
        "event": {
          "name": "token.check.authenticated",
          "attributes": {
            "authenticated": { "type": "boolean", "description": "Is authenticated", "required": true },
            "expiresAt": { "type": "number", "description": "Expiration timestamp", "required": true },
            "expiresIn": { "type": "number", "description": "Expires in seconds", "required": true },
            "shouldRefresh": { "type": "boolean", "description": "Should refresh token", "required": true }
          }
        },
        "references": [
          "src/app/api/auth/token-status/route.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": ["src/app/api/auth/token-status/route.ts"]
        },
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a",
        "dataSchema": {
          "authenticated": {
            "type": "boolean",
            "required": true
          },
          "expiresAt": {
            "type": "number",
            "required": true
          },
          "expiresIn": {
            "type": "number",
            "required": true
          },
          "shouldRefresh": {
            "type": "boolean",
            "required": true
          }
        }
      }
    },
    {
      "id": "token-check-authenticated-expiring",
      "type": "text",
      "text": "# Authenticated (Expiring)\n\nValid token but expiring soon - refresh recommended",
      "x": 100,
      "y": 450,
      "width": 200,
      "height": 100,
      "color": "#d97706",
      "pv": {
        "status": "implemented",
        "event": {
          "name": "token.check.authenticated-expiring",
          "attributes": {
            "authenticated": { "type": "boolean", "description": "Is authenticated", "required": true },
            "expiresAt": { "type": "number", "description": "Expiration timestamp", "required": true },
            "expiresIn": { "type": "number", "description": "Expires in seconds", "required": true },
            "shouldRefresh": { "type": "boolean", "description": "Should refresh token", "required": true }
          }
        },
        "references": [
          "src/app/api/auth/token-status/route.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": ["src/app/api/auth/token-status/route.ts"]
        },
        "shape": "rectangle",
        "fill": "#f59e0b",
        "stroke": "#d97706",
        "dataSchema": {
          "authenticated": {
            "type": "boolean",
            "required": true
          },
          "expiresAt": {
            "type": "number",
            "required": true
          },
          "expiresIn": {
            "type": "number",
            "required": true
          },
          "shouldRefresh": {
            "type": "boolean",
            "required": true
          }
        }
      }
    },
    {
      "id": "token-check-unauthenticated",
      "type": "text",
      "text": "# Unauthenticated\n\nNo valid token - unauthenticated",
      "x": 450,
      "y": 250,
      "width": 200,
      "height": 100,
      "color": "#1d4ed8",
      "pv": {
        "status": "implemented",
        "event": {
          "name": "token.check.unauthenticated",
          "attributes": {
            "authenticated": { "type": "boolean", "description": "Is authenticated", "required": true }
          }
        },
        "references": [
          "src/app/api/auth/token-status/route.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": ["src/app/api/auth/token-status/route.ts"]
        },
        "shape": "rectangle",
