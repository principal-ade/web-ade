{
  "version": "1.0.0",
  "canvas": ".principal-views/tts-generation/tts-generation.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.tts.generate",
  "name": "TTS Rate Limit",
  "description": "Error when ElevenLabs API rate limit is exceeded",
  "scenarios": [
    {
      "id": "rate-limit-error",
      "priority": 1,
      "template": {
        "summary": "⏱️  ElevenLabs rate limit exceeded for {{tts.owner}}/{{tts.repo}}:{{tts.stepId}}, retry after {{tts.retryAfter}}s",
        "events": {
          "tts.cache.miss": "💭 Cache miss, proceeding to generation",
          "tts.tour.fetched": "📄 Tour fetched successfully ({{tts.textLength}} chars)",
          "tts.error.rate_limit": "⏱️  Rate limit hit: {{tts.errorMessage}} (retry after {{tts.retryAfter}}s)"
        }
      }
    }
  ]
}
