{
  "version": "1.0.0",
  "canvas": ".principal-views/tts-generation/tts-generation.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.tts.generate",
  "name": "TTS Tour Not Found",
  "description": "Error when tour file cannot be fetched from GitHub",
  "scenarios": [
    {
      "id": "tour-not-found-error",
      "priority": 1,
      "template": {
        "summary": "❌ Tour not found: {{tts.owner}}/{{tts.repo}}:{{tts.path}}",
        "events": {
          "tts.cache.miss": "💭 Cache miss, attempting to fetch tour",
          "tts.error.tour_not_found": "❌ GitHub returned 404: {{tts.errorMessage}}"
        }
      }
    }
  ]
}
