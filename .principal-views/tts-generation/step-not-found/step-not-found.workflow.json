{
  "version": "1.0.0",
  "canvas": ".principal-views/tts-generation/tts-generation.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.tts.generate",
  "name": "TTS Step Not Found",
  "description": "Error when requested step ID doesn't exist in tour file",
  "scenarios": [
    {
      "id": "step-not-found-error",
      "priority": 1,
      "template": {
        "summary": "❌ Step not found: {{tts.stepId}} in {{tts.owner}}/{{tts.repo}}",
        "events": {
          "tts.cache.miss": "💭 Cache miss, fetching tour",
          "tts.error.step_not_found": "❌ Step validation failed: {{tts.errorMessage}}"
        }
      }
    }
  ]
}
