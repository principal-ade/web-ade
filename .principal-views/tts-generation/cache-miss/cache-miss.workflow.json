{
  "version": "1.0.0",
  "canvas": ".principal-views/tts-generation/tts-generation.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.tts.generate",
  "name": "TTS Cache Miss",
  "description": "Full generation path when audio needs to be created",
  "scenarios": [
    {
      "id": "generation-success",
      "priority": 1,
      "template": {
        "summary": "✅ Generated TTS audio for {{tts.owner}}/{{tts.repo}}:{{tts.stepId}} ({{tts.textLength}} chars) in {{tts.generationTimeMs}}ms",
        "events": {
          "tts.cache.miss": "💭 Cache miss at {{tts.s3Key}}, proceeding to generation",
          "tts.tour.fetched": "📄 Tour fetched (ID: {{tts.tourId}}), step description: {{tts.textLength}} characters",
          "tts.audio.generated": "🎙️  Audio generated using {{tts.voice}} in {{tts.generationTimeMs}}ms ({{tts.audioSizeBytes}} bytes)",
          "tts.audio.uploaded": "☁️  Uploaded to S3: {{tts.audioUrl}}",
          "tts.request.complete": "✅ Audio URL returned (total duration: {{tts.durationMs}}ms)"
        }
      }
    }
  ]
}
