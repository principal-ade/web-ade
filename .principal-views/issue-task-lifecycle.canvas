{
  "pv": {
    "name": "Issue to Task Lifecycle",
    "version": "1.0.0",
    "nodeTypes": {
      "panel": {
        "label": "UI Panel",
        "description": "User interface panel component"
      },
      "api-route": {
        "label": "API Route",
        "description": "Next.js API route handler"
      },
      "context": {
        "label": "Context/State",
        "description": "React context state management"
      },
      "event": {
        "label": "Event",
        "description": "Panel event emission"
      },
      "file-system": {
        "label": "File System",
        "description": "File operations and storage"
      },
      "external": {
        "label": "External API",
        "description": "GitHub API calls"
      }
    },
    "edgeTypes": {
      "user-action": {
        "label": "User Action"
      },
      "event": {
        "label": "Event"
      },
      "api-call": {
        "label": "API Call"
      },
      "data-flow": {
        "label": "Data Flow"
      },
      "file-op": {
        "label": "File Operation"
      },
      "state-update": {
        "label": "State Update"
      }
    }
  },
