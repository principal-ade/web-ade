      "event": {
        "name": "feed.profile.s3.put",
        "attributes": {
          "githubId": {
            "type": "string",
            "description": "User's GitHub ID",
            "required": true
          },
          "subscriptionCount": {
            "type": "number",
            "description": "Updated subscription count",
            "required": true
          }
        }
      }
    },
    {
      "id": "view-public-collection",
      "type": "otel-event",
      "x": 500,
      "y": 450,
      "width": 220,
      "height": 90,
      "color": "#0891b2",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/app/api/feed/collections/public/[id]/route.ts"
        ]
      },
