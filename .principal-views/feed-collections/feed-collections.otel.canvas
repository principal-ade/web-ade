      "event": {
        "name": "feed.collection.unsubscribe",
        "attributes": {
          "collectionId": {
            "type": "string",
            "description": "Collection to unsubscribe from",
            "required": true
          },
          "subscriberGithubId": {
            "type": "string",
            "description": "Subscriber's GitHub ID",
            "required": true
          }
        }
      }
    },
    {
      "id": "update-user-profile",
      "type": "otel-event",
      "x": 500,
      "y": 300,
      "width": 220,
      "height": 90,
