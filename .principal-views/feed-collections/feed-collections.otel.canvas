      },
      "pv": {
        "references": [
          "src/app/api/feed/collections/[id]/subscribe/route.ts"
        ]
      },
      "label": "Subscribe",
      "event": {
        "name": "feed.collection.subscribe",
        "attributes": {
          "collectionId": {
            "type": "string",
            "description": "Collection to subscribe to",
            "required": true
          },
          "subscriberGithubId": {
            "type": "string",
            "description": "Subscriber's GitHub ID",
            "required": true
          }
        }
      }
    },
    {
      "id": "unsubscribe-from-collection",
      "type": "otel-event",
      "x": 500,
