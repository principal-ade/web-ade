            "type": "string",
            "description": "Collection ID that wasn't found",
            "required": true
          }
        }
      }
    },
    {
      "id": "collection-access-denied",
      "type": "otel-event",
      "x": 750,
      "y": 450,
      "width": 220,
      "height": 90,
      "color": "#dc2626",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/app/api/feed/collections/[id]/route.ts"
        ]
      },
      "label": "Access Denied",
      "event": {
        "name": "feed.collection.access-denied",
        "attributes": {
          "collectionId": {
            "type": "string",
            "description": "Private collection ID",
            "required": true
          },
          "requestorGithubId": {
            "type": "string",
            "description": "Requestor's GitHub ID",
            "required": true
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "load-1",
      "fromNode": "feed-load-started",
      "fromSide": "bottom",
      "toNode": "fetch-user-profile",
      "toSide": "top",
      "label": "authenticated",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "load-2",
      "fromNode": "feed-load-started",
      "fromSide": "right",
      "toNode": "use-featured-repos",
      "toSide": "top",
      "label": "anonymous",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "load-3",
      "fromNode": "fetch-user-profile",
      "fromSide": "right",
      "toNode": "profile-not-found",
      "toSide": "left",
      "label": "404",
      "pv": {
        "edgeType": "error"
      }
    },
    {
      "id": "load-4",
      "fromNode": "profile-not-found",
      "fromSide": "bottom",
      "toNode": "use-featured-repos",
      "toSide": "top",
      "label": "fallback",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "load-5",
      "fromNode": "fetch-user-profile",
      "fromSide": "bottom",
      "toNode": "profile-loaded",
      "toSide": "top",
      "label": "success",
      "pv": {
        "edgeType": "s3"
      }
    },
    {
      "id": "load-6",
      "fromNode": "profile-loaded",
      "fromSide": "bottom",
      "toNode": "fetch-collections",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "load-7",
      "fromNode": "fetch-collections",
      "fromSide": "bottom",
      "toNode": "collections-loaded",
      "toSide": "top",
      "pv": {
        "edgeType": "s3"
      }
    },
    {
      "id": "load-8",
      "fromNode": "collections-loaded",
      "fromSide": "bottom",
      "toNode": "merge-repos",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "load-9",
      "fromNode": "merge-repos",
      "fromSide": "bottom",
      "toNode": "feed-ready",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "load-10",
      "fromNode": "use-featured-repos",
      "fromSide": "bottom",
      "toNode": "feed-ready",
      "toSide": "right",
      "label": "direct",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "create-1",
      "fromNode": "collection-create-started",
      "fromSide": "bottom",
      "toNode": "collection-s3-put",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "create-2",
      "fromNode": "collection-s3-put",
      "fromSide": "bottom",
      "toNode": "collection-created",
      "toSide": "top",
      "pv": {
        "edgeType": "s3"
      }
    },
    {
      "id": "sub-1",
      "fromNode": "subscribe-to-collection",
      "fromSide": "bottom",
      "toNode": "update-user-profile",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "sub-2",
      "fromNode": "unsubscribe-from-collection",
      "fromSide": "bottom",
      "toNode": "update-user-profile",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "repo-add-1",
      "fromNode": "add-repo-to-collection",
      "fromSide": "bottom",
      "toNode": "collection-s3-put",
      "toSide": "right",
      "label": "update",
