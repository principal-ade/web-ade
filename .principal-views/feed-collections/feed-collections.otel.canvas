      "event": {
        "name": "feed.collection.public.view",
        "attributes": {
          "collectionId": {
            "type": "string",
            "description": "Public collection ID",
            "required": true
          },
          "viewerGithubId": {
            "type": "string",
            "description": "Viewer's GitHub ID (if authenticated)",
            "required": false
          }
        }
      }
