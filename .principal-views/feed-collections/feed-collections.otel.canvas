{
  "pv": {
    "name": "Feed Collections",
    "version": "1.0.0",
    "markdown": ".principal-views/feed-collections/feed-collections.md",
    "edgeTypes": {
      "flow": {
        "label": "Flow"
      },
      "error": {
        "label": "Error Path"
      },
      "user-action": {
        "label": "User Action"
      },
      "data-flow": {
        "label": "Data Flow"
      },
      "s3": {
        "label": "S3 Operation"
      }
    }
  },
  "nodes": [
    {
      "id": "feed-load-started",
      "type": "otel-event",
      "x": -400,
      "y": 0,
      "width": 220,
      "height": 90,
      "color": "#16a34a",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/hooks/usePersonalizedFeed.ts"
        ]
      },
      "label": "Feed Load Started",
      "event": {
        "name": "feed.load.started",
        "attributes": {
          "githubId": {
            "type": "string",
            "description": "User's GitHub ID",
            "required": true
          },
          "isAuthenticated": {
            "type": "boolean",
            "description": "Whether user is logged in",
            "required": true
          }
        }
      }
    },
    {
      "id": "fetch-user-profile",
      "type": "otel-event",
      "x": -400,
      "y": 150,
      "width": 220,
      "height": 90,
      "color": "#6d28d9",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/lib/feed-collections/s3-storage.ts"
        ]
      },
      "label": "Fetch User Profile",
      "event": {
        "name": "feed.profile.fetch",
        "attributes": {
          "githubId": {
            "type": "string",
            "description": "User's GitHub ID",
            "required": true
          }
        }
      }
    },
    {
      "id": "profile-not-found",
      "type": "otel-event",
      "x": -100,
      "y": 150,
      "width": 200,
      "height": 90,
      "color": "#d97706",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/lib/feed-collections/s3-storage.ts"
        ]
      },
      "label": "Profile Not Found",
      "event": {
        "name": "feed.profile.not-found",
        "attributes": {
          "githubId": {
            "type": "string",
            "description": "User's GitHub ID",
            "required": true
          }
        }
      }
    },
    {
      "id": "use-featured-repos",
      "type": "otel-event",
      "x": -100,
      "y": 300,
      "width": 200,
      "height": 90,
      "color": "#4b5563",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/lib/featured-repos.ts"
        ]
      },
      "label": "Use Featured Repos",
      "event": {
        "name": "feed.fallback.featured",
        "attributes": {
          "repoCount": {
            "type": "number",
            "description": "Number of featured repos",
            "required": true
          }
        }
      }
    },
    {
      "id": "profile-loaded",
      "type": "otel-event",
      "x": -400,
      "y": 300,
      "width": 220,
      "height": 90,
      "color": "#16a34a",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/lib/feed-collections/s3-storage.ts"
        ]
      },
      "label": "Profile Loaded",
      "event": {
        "name": "feed.profile.loaded",
        "attributes": {
          "githubId": {
            "type": "string",
            "description": "User's GitHub ID",
            "required": true
          },
          "subscriptionCount": {
            "type": "number",
            "description": "Number of subscribed collections",
            "required": true
          }
        }
      }
    },
    {
      "id": "fetch-collections",
      "type": "otel-event",
      "x": -400,
      "y": 450,
      "width": 220,
      "height": 90,
      "color": "#6d28d9",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/lib/feed-collections/s3-storage.ts"
        ]
      },
      "label": "Fetch Collections",
      "event": {
        "name": "feed.collections.fetch",
        "attributes": {
          "collectionIds": {
            "type": "array",
            "description": "IDs of collections to fetch",
            "required": true
          }
        }
      }
    },
    {
      "id": "collections-loaded",
      "type": "otel-event",
      "x": -400,
      "y": 600,
      "width": 220,
      "height": 90,
      "color": "#16a34a",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/hooks/usePersonalizedFeed.ts"
        ]
      },
      "label": "Collections Loaded",
      "event": {
        "name": "feed.collections.loaded",
        "attributes": {
          "collectionCount": {
            "type": "number",
            "description": "Number of collections loaded",
            "required": true
          },
          "totalRepos": {
            "type": "number",
            "description": "Total repos across all collections",
            "required": true
          }
        }
      }
    },
    {
      "id": "merge-repos",
      "type": "otel-event",
      "x": -400,
      "y": 750,
      "width": 220,
      "height": 90,
      "color": "#0891b2",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/hooks/usePersonalizedFeed.ts"
        ]
      },
      "label": "Merge Repos",
      "event": {
        "name": "feed.repos.merge",
        "attributes": {
          "uniqueRepoCount": {
            "type": "number",
            "description": "Deduplicated repo count",
            "required": true
          }
        }
      }
    },
    {
      "id": "feed-ready",
      "type": "otel-event",
      "x": -400,
      "y": 900,
      "width": 220,
      "height": 90,
      "color": "#16a34a",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/panels/ActivityFeedPanel.tsx"
        ]
      },
      "label": "Feed Ready",
      "event": {
        "name": "feed.ready",
        "attributes": {
          "repoCount": {
            "type": "number",
            "description": "Total repos in feed",
            "required": true
          },
          "source": {
            "type": "string",
            "description": "Source: 'personalized' or 'featured'",
            "required": true
          }
        }
      }
    },
    {
      "id": "collection-create-started",
      "type": "otel-event",
      "x": 200,
      "y": 0,
      "width": 220,
      "height": 90,
      "color": "#1d4ed8",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/app/api/feed/collections/route.ts"
        ]
      },
      "label": "Create Collection",
      "event": {
        "name": "feed.collection.create.started",
        "attributes": {
          "name": {
            "type": "string",
            "description": "Collection name",
            "required": true
          },
          "visibility": {
            "type": "string",
            "description": "public or private",
            "required": true
          }
        }
      }
    },
    {
      "id": "collection-s3-put",
      "type": "otel-event",
      "x": 200,
      "y": 150,
      "width": 220,
      "height": 90,
      "color": "#6d28d9",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/lib/feed-collections/s3-storage.ts"
        ]
      },
      "label": "S3 Put Collection",
      "event": {
        "name": "feed.collection.s3.put",
        "attributes": {
          "collectionId": {
            "type": "string",
            "description": "Collection UUID",
            "required": true
          },
          "s3Key": {
            "type": "string",
            "description": "S3 object key",
            "required": true
          }
        }
      }
    },
    {
      "id": "collection-created",
      "type": "otel-event",
      "x": 200,
      "y": 300,
      "width": 220,
      "height": 90,
      "color": "#16a34a",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/app/api/feed/collections/route.ts"
        ]
      },
      "label": "Collection Created",
      "event": {
        "name": "feed.collection.created",
        "attributes": {
          "collectionId": {
            "type": "string",
            "description": "New collection ID",
            "required": true
          },
          "ownerGithubId": {
            "type": "string",
            "description": "Owner's GitHub ID",
            "required": true
          }
        }
      }
    },
    {
      "id": "add-repo-to-collection",
      "type": "otel-event",
      "x": 200,
      "y": 450,
      "width": 220,
      "height": 90,
      "color": "#1d4ed8",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/app/api/feed/collections/[id]/repos/route.ts"
        ]
      },
      "label": "Add Repo",
      "event": {
        "name": "feed.collection.repo.add",
        "attributes": {
          "collectionId": {
            "type": "string",
            "description": "Collection ID",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "Repo owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repo name",
            "required": true
          }
        }
      }
    },
    {
      "id": "remove-repo-from-collection",
      "type": "otel-event",
      "x": 200,
      "y": 600,
      "width": 220,
      "height": 90,
      "color": "#dc2626",
      "otel": {
        "status": "draft"
      },
      "pv": {
        "references": [
          "src/app/api/feed/collections/[id]/repos/route.ts"
        ]
      },
      "label": "Remove Repo",
      "event": {
        "name": "feed.collection.repo.remove",
        "attributes": {
          "collectionId": {
            "type": "string",
            "description": "Collection ID",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "Repo owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repo name",
            "required": true
          }
        }
      }
    },
    {
      "id": "subscribe-to-collection",
      "type": "otel-event",
      "x": 500,
      "y": 0,
      "width": 220,
      "height": 90,
