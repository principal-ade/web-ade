{
  "version": "1.0.0",
  "canvas": ".principal-views/collections/collections.otel.canvas",
  "spanPattern": "api.github.collections.load",
  "name": "Load User Collections",
  "description": "Fetch user's own collections from GitHub repository",
  "scenarios": [
    {
      "id": "success-with-collections",
      "description": "Successfully loaded the user's collections from their GitHub repository",
      "priority": 1,
      "template": {
        "summary": "[Success] Loaded {collectionCount} collections",
        "events": {
          "collections.load.started": "Fetching collections for {{username}}",
          "collections.load.github.fetch": "Fetching from GitHub repo: {{repoUrl}}",
          "collections.load.success": "Loaded {{collectionCount}} collections and {{membershipCount}} memberships"
        }
      }
    },
    {
      "id": "repo-not-found",
      "description": "Load completed with no collections because the user's GitHub repository doesn't exist yet",
      "priority": 2,
      "template": {
        "summary": "[Skipped] No collections repo found",
        "events": {
          "collections.load.started": "Fetching collections for {{username}}",
          "collections.load.github.not-found": "Collections repo not found: {{reason}}"
        }
      }
    },
    {
      "id": "unauthorized",
      "description": "Load failed because the user is not authenticated",
      "priority": 3,
      "template": {
        "summary": "[Unauthorized] Authentication required",
        "events": {
          "collections.load.started": "Fetching collections for {{username}}",
          "collections.load.unauthorized": "Not authenticated: {{reason}}"
        }
      }
    },
    {
      "id": "error",
      "description": "Load failed due to an unexpected error (e.g., GitHub API error, network issue)",
      "priority": 4,
      "template": {
        "summary": "[Error] Failed to load collections: {error.message}",
        "events": {
          "collections.load.started": "Fetching collections for {{username}}",
          "collections.load.error": "Error loading collections: {{error.message}}"
        }
      }
    }
  ]
}
