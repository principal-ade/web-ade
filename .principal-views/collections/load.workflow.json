{
  "version": "1.0.0",
  "canvas": ".principal-views/collections/collections.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.github.collections.load",
  "name": "Load User Collections",
  "description": "Fetch user's own collections from GitHub repository",
  "scenarios": [
    {
      "id": "success-with-collections",
      "priority": 1,
      "template": {
        "summary": "✅ Loaded {collectionCount} collections",
        "events": {
          "collections.load.started": "Fetching collections for authenticated user",
          "collections.load.github.fetch": "Fetching from GitHub repo: {{repoUrl}}",
          "collections.load.success": "Loaded {{collectionCount}} collections and {{membershipCount}} memberships"
        }
      }
    },
    {
      "id": "repo-not-found",
      "priority": 2,
      "template": {
        "summary": "⚪ No collections repo found",
        "events": {
          "collections.load.started": "Fetching collections for authenticated user",
          "collections.load.github.not-found": "Collections repo doesn't exist yet (404)"
        }
      }
    },
    {
      "id": "unauthorized",
      "priority": 3,
      "template": {
        "summary": "🔒 Authentication required",
        "events": {
          "collections.load.started": "Fetching collections for authenticated user",
          "collections.load.unauthorized": "User not authenticated (401)"
        }
      }
    },
    {
      "id": "error",
      "priority": 4,
      "template": {
        "summary": "❌ Failed to load collections: {error.message}",
        "events": {
          "collections.load.started": "Fetching collections for authenticated user",
          "collections.load.error": "Error loading collections: {{error.message}}"
        }
      }
    }
  ]
}
