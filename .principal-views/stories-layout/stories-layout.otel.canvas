{
  "pv": {
    "name": "Stories Layout",
    "version": "1.0.0",
    "markdown": ".principal-views/stories-layout/stories-layout.md",
    "edgeTypes": {
      "flow": {
        "label": "Flow"
      },
      "error": {
        "label": "Error Path"
      },
      "user-action": {
        "label": "User Action"
      },
      "data-flow": {
        "label": "Data Flow"
      },
      "event": {
        "label": "Event Bus"
      }
    }
  },
  "nodes": [
    {
      "id": "layout-switch-stories",
      "type": "otel-event",
      "x": 0,
      "y": 0,
      "width": 220,
      "height": 90,
      "color": "#0891b2",
      "pv": {
        "status": "implemented",
        "references": [
          "src/components/LayoutConfigDropdown.tsx",
          "src/components/EditorLayout.tsx"
        ]
      },
      "label": "Switch to Stories Layout",
      "event": {
        "name": "stories.layout.switch",
        "attributes": {
          "layoutId": {
            "type": "string",
            "description": "Layout ID (stories)",
            "required": true
          }
        }
      }
    },
    {
      "id": "storyboard-list-panel-mount",
      "type": "otel-event",
      "x": 0,
      "y": 150,
      "width": 220,
      "height": 90,
      "color": "#6d28d9",
      "pv": {
        "status": "implemented",
        "references": [
          "src/components/EditorLayout.tsx"
        ]
      },
      "label": "Storyboard List Panel Mount",
      "event": {
        "name": "stories.panel.storyboard-list.mount",
        "attributes": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          }
        }
      }
    },
    {
      "id": "canvases-load",
      "type": "otel-event",
      "x": 0,
      "y": 300,
      "width": 220,
      "height": 90,
      "color": "#6d28d9",
      "pv": {
        "status": "implemented",
        "references": [
          "src/contexts/RepositoryPageProvider.tsx"
        ]
      },
      "label": "Load OTEL Canvases",
      "event": {
        "name": "stories.canvases.load",
        "attributes": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          }
        }
      }
    },
    {
      "id": "canvases-success",
      "type": "otel-event",
      "x": 0,
      "y": 450,
      "width": 220,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "implemented",
        "references": [
          "src/contexts/RepositoryPageProvider.tsx"
        ]
      },
      "label": "Canvases Ready",
      "event": {
        "name": "stories.canvases.success",
        "attributes": {
          "canvasCount": {
            "type": "number",
            "description": "Number of canvases found",
            "required": true
          },
          "workflowCount": {
            "type": "number",
            "description": "Number of workflows found",
            "required": true
          }
        }
      }
    },
    {
      "id": "canvases-error",
      "type": "otel-event",
      "x": 280,
      "y": 300,
      "width": 220,
      "height": 90,
      "color": "#dc2626",
      "pv": {
        "status": "approved",
        "references": [
          "src/contexts/RepositoryPageProvider.tsx"
        ]
      },
      "label": "Canvases Load Error",
      "event": {
        "name": "stories.canvases.error",
        "attributes": {
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          }
        }
      }
    },
    {
      "id": "canvas-select",
      "type": "otel-event",
      "x": 0,
      "y": 600,
      "width": 220,
      "height": 90,
      "color": "#0891b2",
      "pv": {
        "status": "approved",
        "references": [
          "src/contexts/RepositoryPageProvider.tsx",
          "src/components/EditorLayout.tsx"
        ]
      },
      "label": "Select Canvas",
      "event": {
        "name": "stories.canvas.select",
        "attributes": {
          "canvasPath": {
            "type": "string",
            "description": "Path to selected canvas",
            "required": true
          },
          "canvasName": {
            "type": "string",
            "description": "Canvas display name",
            "required": true
          },
          "openMode": {
            "type": "string",
            "description": "How to open (view or edit)",
            "required": false
          }
        }
      }
    },
    {
      "id": "emit-open-canvas",
      "type": "otel-event",
      "x": 0,
      "y": 750,
      "width": 220,
      "height": 90,
      "color": "#ea580c",
