      "label": "Emit openCanvas Event",
      "event": {
        "name": "stories.event.openCanvas",
        "attributes": {
          "source": {
            "type": "string",
            "description": "Event source (storyboard-list-panel)",
            "required": true
          },
          "action": {
            "type": "string",
            "description": "Action type (openCanvas)",
            "required": true
          },
          "canvas.path": {
            "type": "string",
            "description": "Canvas file path",
            "required": true
          },
          "canvas.id": {
            "type": "string",
            "description": "Canvas ID",
            "required": true
          },
          "openMode": {
            "type": "string",
            "description": "Open mode (view/edit)",
            "required": false
          }
        }
      }
    },
    {
      "id": "editor-layout-receive",
      "type": "otel-event",
      "x": 300,
      "y": 750,
      "width": 220,
      "height": 90,
      "color": "#6d28d9",
      "pv": {
        "status": "implemented",
        "references": [
