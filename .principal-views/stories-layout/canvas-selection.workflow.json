{
  "version": "1.0.0",
  "canvas": ".principal-views/stories-layout/stories-layout.otel.canvas",
  "spanPattern": "stories.panel.file-city.render",
  "name": "Canvas Selection Flow",
  "description": "User selects a canvas and storyboard context flows to File City panel",
  "scenarios": [
    {
      "id": "canvas-select-highlight",
      "description": "User selects canvas from storyboard list, File City highlights referenced files",
      "priority": 1,
      "template": {
        "summary": "[Stories] Canvas selected, {{highlightedCount}} files highlighted",
        "events": {
          "stories.layout.switch": "Switched to Stories layout ({{layoutId}})",
          "stories.panel.storyboard-list.mount": "Storyboard list panel mounted for {{owner}}/{{repo}}",
          "stories.canvases.load": "Loading canvases for {{owner}}/{{repo}}",
          "stories.canvases.success": "Found {{canvasCount}} canvases, {{workflowCount}} workflows",
          "stories.canvases.error": "Failed to load canvases: {{error.message}}",
          "stories.canvas.select": "Selected canvas: {{canvasName}} at {{canvasPath}} (mode: {{openMode}})",
          "stories.event.openCanvas": "Emitting {{action}} event from {{source}} for {{canvas.id}} at {{canvas.path}} (mode: {{openMode}})",
          "stories.editor.receive.openCanvas": "EditorLayout received canvas: {{canvasPath}} (mode: {{openMode}})",
          "stories.state.selectedCanvasData": "Stored canvas data: {{canvasId}} ({{canvasName}}) at {{canvasPath}}",
          "stories.panel.canvas-editor.render": "Canvas editor rendered: {{canvasPath}} with {{nodeCount}} nodes, {{edgeCount}} edges",
          "stories.context.build": "Building storyboard context for {{canvasPath}} (workflow: {{hasWorkflow}}, scenario: {{hasScenario}})",
          "stories.event.context.update": "Emitting {{type}} from {{source}} (hasContext: {{hasContext}})",
          "stories.file-city.receive.context": "File City received context with {{nodeCount}} nodes (hasHighlights: {{hasHighlights}})",
          "stories.file-city.highlights.apply": "Applied highlights to {{highlightedFiles}} files (colorMode: {{colorMode}})",
          "stories.panel.file-city.render": "File City rendered {{fileCount}} files, {{highlightedCount}} highlighted"
        }
      }
    },
    {
      "id": "workflow-select-context",
      "description": "User selects a workflow, context is rebuilt with workflow data",
      "priority": 2,
      "template": {
        "summary": "[Stories] Workflow {{workflowId}} selected with {{scenarioCount}} scenarios",
        "events": {
          "stories.workflow.select": "Selected workflow: {{workflowId}} at {{workflowPath}} ({{scenarioCount}} scenarios)",
          "stories.event.openWorkflowScenarios": "Emitting {{action}} for workflow {{workflowId}} at {{workflowPath}} (canvas: {{canvasId}} at {{canvasPath}}, {{scenarioCount}} scenarios)",
          "stories.editor.receive.openWorkflowScenarios": "EditorLayout received workflow: {{workflowId}} at {{workflowPath}} ({{scenarioCount}} scenarios)",
          "stories.state.selectedWorkflowData": "Stored workflow data: {{workflowId}} at {{workflowPath}} ({{scenarioCount}} scenarios)",
          "stories.context.build": "Rebuilding context for {{canvasPath}} with workflow ({{hasWorkflow}}) and scenario ({{hasScenario}})",
          "stories.event.context.update": "Emitting {{type}} from {{source}} (hasContext: {{hasContext}})",
          "stories.file-city.receive.context": "File City received updated context with {{nodeCount}} nodes (hasHighlights: {{hasHighlights}})"
        }
      }
    },
    {
      "id": "scenario-select-context",
      "description": "User selects a scenario within a workflow",
      "priority": 3,
      "template": {
        "summary": "[Stories] Scenario {{scenarioName}} selected",
        "events": {
          "stories.scenario.select": "Selected scenario: {{scenarioId}} ({{scenarioName}})",
          "stories.context.build": "Rebuilding context for {{canvasPath}} with workflow ({{hasWorkflow}}) and scenario ({{hasScenario}})"
        }
      }
    },
    {
      "id": "node-focus",
      "description": "User clicks canvas node, File City focuses on referenced files",
      "priority": 4,
      "template": {
        "summary": "[Stories] Node clicked, focusing {{focusedFiles}} files",
        "events": {
          "stories.canvas.node.click": "Clicked node {{nodeId}} (type: {{nodeType}}, hasReferences: {{hasReferences}})",
          "stories.event.focus.files": "Emitting focus event from {{source}} for files: {{filePaths}}",
          "stories.file-city.focus": "Focusing on {{focusedFiles}} files (animate: {{cameraAnimation}})"
        }
      }
    }
  ]
}
