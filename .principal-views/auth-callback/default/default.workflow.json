{
  "version": "1.0.0",
  "canvas": ".principal-views/auth-callback/auth-callback.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.auth.callback",
  "name": "Authentication Callback",
  "description": "OAuth callback handling with PKCE and WorkOS cookie flows",
  "scenarios": [
    {
      "id": "success-pkce",
      "description": "OAuth authentication completed successfully via PKCE code exchange",
      "priority": 1,
      "template": {
        "summary": "✅ Authentication successful via PKCE (completed in {duration.ms}ms)",
        "events": {
          "auth.callback.started": "OAuth callback request received",
          "auth.state.validated": "Validated state and CSRF token for PKCE flow",
          "auth.tokens.received": "Tokens received via code exchange",
          "auth.tokens.received.pkce": "Exchanged code verifier for tokens (user: {{user.id}})",
          "auth.cookies.set": "Set {{cookies.count}} authentication cookies",
          "auth.callback.complete": "Redirecting to {{redirect.path}} (from {{redirect.source}})"
        }
      }
    },
    {
      "id": "success-cookie",
      "description": "OAuth authentication completed successfully via WorkOS cookie session",
      "priority": 2,
      "template": {
        "summary": "✅ Authentication successful via cookie session (completed in {duration.ms}ms)",
        "events": {
          "auth.callback.started": "OAuth callback request received",
          "auth.state.validated": "Validated state and CSRF token for cookie flow",
          "auth.tokens.received": "Tokens received from session",
          "auth.tokens.received.cookie": "Parsed session data from cookie (user: {{user.id}})",
          "auth.cookies.set": "Set {{cookies.count}} authentication cookies",
          "auth.callback.complete": "Redirecting to {{redirect.path}} (from {{redirect.source}})"
        }
      }
    },
    {
      "id": "error",
      "description": "OAuth authentication failed due to an error during the callback process",
      "priority": 3,
      "template": {
        "summary": "❌ Authentication failed: {error.message}",
        "events": {
          "auth.callback.started": "OAuth callback request received",
          "auth.callback.error": "Error at {{error.stage}}: {{error.message}}"
        }
      }
    }
  ]
}
