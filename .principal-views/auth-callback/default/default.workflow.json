{
  "version": "1.0.0",
  "canvas": ".principal-views/auth-callback/auth-callback.otel.canvas",
  "spanPattern": "api.auth.callback",
  "name": "Authentication Callback",
  "description": "OAuth callback handling with PKCE and WorkOS cookie flows",
  "scenarios": [
    {
      "id": "success-pkce",
      "description": "OAuth authentication completed successfully via PKCE code exchange",
      "priority": 1,
      "template": {
        "summary": "[Success] Authentication successful via PKCE (completed in {duration.ms}ms)",
        "events": {
          "auth.callback.started": "OAuth callback (state: {{request.has_state}}, code: {{request.has_code}}, cookie: {{request.has_workos_cookie}}, error: {{request.has_auth_error}})",
          "auth.state.validated": "Validated state (csrf: {{state.csrf}}, redirect: {{state.has_redirect}}, flow: {{flow.type}})",
          "auth.tokens.received": "Tokens from {{tokens.source}} (github: {{tokens.has_github_token}}, workos: {{tokens.has_workos_token}}, refresh: {{tokens.has_refresh_token}}, user: {{user.id}})",
          "auth.tokens.received.pkce": "Exchanged code verifier for tokens (user: {{user.id}})",
          "auth.cookies.set": "Set {{cookies.count}} authentication cookies",
          "auth.callback.complete": "Redirecting to {{redirect.path}} (from {{redirect.source}}, {{duration.ms}}ms)"
        }
      }
    },
    {
      "id": "success-cookie",
      "description": "OAuth authentication completed successfully via WorkOS cookie session",
      "priority": 2,
      "template": {
        "summary": "[Success] Authentication successful via cookie session (completed in {duration.ms}ms)",
        "events": {
          "auth.callback.started": "OAuth callback (state: {{request.has_state}}, code: {{request.has_code}}, cookie: {{request.has_workos_cookie}}, error: {{request.has_auth_error}})",
          "auth.state.validated": "Validated state (csrf: {{state.csrf}}, redirect: {{state.has_redirect}}, flow: {{flow.type}})",
          "auth.tokens.received": "Tokens from {{tokens.source}} (github: {{tokens.has_github_token}}, workos: {{tokens.has_workos_token}}, refresh: {{tokens.has_refresh_token}}, user: {{user.id}})",
          "auth.tokens.received.cookie": "Parsed session data from cookie (user: {{user.id}})",
          "auth.cookies.set": "Set {{cookies.count}} authentication cookies",
          "auth.callback.complete": "Redirecting to {{redirect.path}} (from {{redirect.source}}, {{duration.ms}}ms)"
        }
      }
    },
    {
      "id": "error",
      "description": "OAuth authentication failed due to an error during the callback process",
      "priority": 3,
      "template": {
        "summary": "[Error] Authentication failed: {error.message}",
        "events": {
          "auth.callback.started": "OAuth callback (state: {{request.has_state}}, code: {{request.has_code}}, cookie: {{request.has_workos_cookie}}, error: {{request.has_auth_error}})",
          "auth.callback.error": "{{error.type}} at {{error.stage}}: {{error.message}} ({{error.status_code}})"
        }
      }
    }
  ]
}
