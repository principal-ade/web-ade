  "nodes": [
    {
      "id": "auth-started",
      "type": "text",
      "text": "# Callback Started\n\nOAuth callback request received",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#16a34a",
      "pv": {
        "status": "implemented",
