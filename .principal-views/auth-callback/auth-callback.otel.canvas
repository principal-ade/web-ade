          "category": "lifecycle",
          "files": ["src/app/api/auth/callback/route.ts"]
        },
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a",
        "dataSchema": {
          "request.has_state": {
            "type": "boolean",
            "required": true
          },
          "request.has_code": {
            "type": "boolean",
            "required": true
          },
          "request.has_workos_cookie": {
            "type": "boolean",
            "required": true
          },
          "request.has_auth_error": {
            "type": "boolean",
            "required": false
          }
        }
