      }
    },
    {
      "id": "e-step5-6",
      "fromNode": "step5",
      "toNode": "step6",
      "fromSide": "left",
      "toSide": "right",
      "label": "redirect",
      "pv": {
        "edgeType": "redirect"
      }
    },
    {
      "id": "e-step6-7",
      "fromNode": "step6",
      "toNode": "step7",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "api-call"
      }
    },
    {
      "id": "e-step7-8",
      "fromNode": "step7",
      "toNode": "step8",
