  "nodes": [
    {
      "id": "get-started",
      "type": "otel-event",
      "x": -400,
      "y": 0,
      "width": 200,
      "height": 90,
      "label": "GET Request",
      "event": {
        "name": "line-counts.get.started",
        "attributes": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "forceCompute": {
            "type": "boolean",
            "description": "Force recomputation flag",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
