{
  "version": "1.0.0",
  "canvas": ".principal-views/line-counts/line-counts.otel.canvas",
  "spanPattern": "api.line-counts.get",
  "name": "Get Line Counts",
  "description": "Retrieve line counts for a repository, computing on-demand if not cached",
  "scenarios": [
    {
      "id": "cache-hit",
      "description": "Line counts found in S3 cache, returned immediately",
      "priority": 1,
      "template": {
        "summary": "[Cache Hit] {owner}/{repo} - {fileCount} files",
        "events": {
          "line-counts.get.started": "GET line counts for {{owner}}/{{repo}} (forceCompute: {{forceCompute}})",
          "line-counts.cache.check": "Checking S3 cache for {{owner}}/{{repo}}",
          "line-counts.cache.hit": "Cache hit for {{owner}}/{{repo}}: {{fileCount}} files found"
        }
      }
    },
    {
      "id": "compute-success",
      "description": "Cache miss, computed line counts on-demand successfully",
      "priority": 2,
      "template": {
        "summary": "[Computed] {owner}/{repo} - {fileCount} files in {durationMs}ms",
        "events": {
          "line-counts.get.started": "GET line counts for {{owner}}/{{repo}} (forceCompute: {{forceCompute}})",
          "line-counts.cache.check": "Checking S3 cache for {{owner}}/{{repo}}",
          "line-counts.cache.miss": "Cache miss for {{owner}}/{{repo}}",
          "line-counts.auth.check": "Checking authentication for {{owner}}/{{repo}}",
          "line-counts.tree.fetch": "Fetching GitHub tree for {{owner}}/{{repo}}",
          "line-counts.size.check": "Repository has {{fileCount}} files (max: {{maxFiles}})",
          "line-counts.compute.start": "Computing line counts for {{owner}}/{{repo}} ({{fileCount}} files)",
          "line-counts.compute.complete": "Computed {{owner}}/{{repo}}: {{fileCount}} files in {{durationMs}}ms",
          "line-counts.cache.store": "Storing {{owner}}/{{repo}} in S3 ({{fileCount}} files, generated by {{generatedBy}})"
        }
      }
    },
    {
      "id": "auth-required",
      "description": "Cache miss and GitHub token required for on-demand computation",
      "priority": 3,
      "template": {
        "summary": "[Auth Required] {owner}/{repo} - GitHub token needed",
        "events": {
          "line-counts.get.started": "GET line counts for {{owner}}/{{repo}} (forceCompute: {{forceCompute}})",
          "line-counts.cache.check": "Checking S3 cache for {{owner}}/{{repo}}",
          "line-counts.cache.miss": "Cache miss for {{owner}}/{{repo}}",
          "line-counts.auth.check": "Checking authentication for {{owner}}/{{repo}}",
          "line-counts.auth.required": "GitHub token required for {{owner}}/{{repo}}"
        }
      }
    },
    {
      "id": "repo-too-large",
      "description": "Repository exceeds file count limit for on-demand computation",
      "priority": 4,
      "template": {
        "summary": "[Too Large] {owner}/{repo} - {fileCount} files exceeds limit",
        "events": {
          "line-counts.get.started": "GET line counts for {{owner}}/{{repo}} (forceCompute: {{forceCompute}})",
          "line-counts.cache.check": "Checking S3 cache for {{owner}}/{{repo}}",
          "line-counts.cache.miss": "Cache miss for {{owner}}/{{repo}}",
          "line-counts.auth.check": "Checking authentication for {{owner}}/{{repo}}",
          "line-counts.tree.fetch": "Fetching GitHub tree for {{owner}}/{{repo}}",
          "line-counts.size.check": "Repository has {{fileCount}} files (max: {{maxFiles}})",
          "line-counts.too-large": "Repository {{owner}}/{{repo}} has {{fileCount}} files, exceeds limit"
        }
      }
    },
    {
      "id": "compute-error",
      "description": "Line count computation failed due to an error",
      "priority": 5,
      "template": {
        "summary": "[Error] {owner}/{repo} - {error.message}",
        "events": {
          "line-counts.get.started": "GET line counts for {{owner}}/{{repo}} (forceCompute: {{forceCompute}})",
          "line-counts.cache.check": "Checking S3 cache for {{owner}}/{{repo}}",
          "line-counts.cache.miss": "Cache miss for {{owner}}/{{repo}}",
          "line-counts.auth.check": "Checking authentication for {{owner}}/{{repo}}",
          "line-counts.tree.fetch": "Fetching GitHub tree for {{owner}}/{{repo}}",
          "line-counts.size.check": "Repository has {{fileCount}} files (max: {{maxFiles}})",
          "line-counts.compute.start": "Computing line counts for {{owner}}/{{repo}} ({{fileCount}} files)",
          "line-counts.compute.error": "Computation failed for {{owner}}/{{repo}}: {{error.message}}"
        }
      }
    }
  ]
}
