{
  "version": "1.0.0",
  "canvas": ".principal-views/shared-collections/shared-collections.otel.canvas",
  "spanPattern": "shared.panel.collection-map",
  "name": "Collection Map Data",
  "description": "Data hydration flows that feed the Collection Map Panel",
  "scenarios": [
    {
      "id": "repo-details-to-map",
      "description": "Repository details hydrate and flow to map for sprite rendering",
      "priority": 1,
      "template": {
        "summary": "[Repo Details] {{repositoryCount}} repos loaded",
        "events": {
          "shared.hydrate.repo-details.start": "Loading details for {{repositoryCount}} repos in {{collectionId}}",
          "shared.hydrate.repo-details.item": "Loaded {{repositoryId}} ({{completedCount}}/{{totalCount}})",
          "shared.hydrate.repo-details.complete": "All {{loadedCount}} repo details loaded for {{collectionId}}",
          "shared.state.repo-details.updated": "State updated with {{repositoryCount}} repos",
          "shared.panel.collection-map.render": "Map rendered with {{repositoryCount}} repos"
        }
      }
    },
    {
      "id": "packages-to-map",
      "description": "Package counts hydrate and flow to map for sprite sizing",
      "priority": 2,
      "template": {
        "summary": "[Packages] {{totalPackages}} packages loaded",
        "events": {
          "shared.hydrate.packages.start": "Loading packages for {{repositoryCount}} repos in {{collectionId}}",
          "shared.hydrate.packages.item": "{{repositoryId}}: {{packageCount}} packages",
          "shared.hydrate.packages.complete": "All packages loaded ({{totalPackages}} total) for {{collectionId}}",
          "shared.state.packages.updated": "State updated with {{totalPackages}} packages ({{repositoryCount}} repos)",
          "shared.panel.collection-map.render": "Map re-rendered with package sizing"
        }
      }
    }
  ]
}
