{
  "version": "1.0.0",
  "canvas": ".principal-views/shared-collections/shared-collections.otel.canvas",
  "spanPattern": "shared.repository",
  "name": "Repository Preview",
  "description": "Click a repository on the map to preview in File City",
  "scenarios": [
    {
      "id": "success",
      "description": "Repository clicked and File City loads successfully",
      "priority": 1,
      "template": {
        "summary": "[Preview] {{repositoryId}} with {{fileCount}} files",
        "events": {
          "shared.repository.clicked": "User clicked {{repositoryId}}",
          "shared.repository.file-tree.load": "Fetching file tree for {{repositoryId}}",
          "shared.repository.file-tree.success": "File City ready: {{repositoryId}} with {{fileCount}} files"
        }
      }
    },
    {
      "id": "error",
      "description": "Failed to load repository file tree",
      "priority": 2,
      "template": {
        "summary": "[Error] Failed to load {{repositoryId}}",
        "events": {
          "shared.repository.clicked": "User clicked {{repositoryId}}",
          "shared.repository.file-tree.load": "Fetching file tree for {{repositoryId}}",
          "shared.repository.file-tree.error": "Failed to load {{repositoryId}}: {{error.message}}"
        }
      }
    }
  ]
}
