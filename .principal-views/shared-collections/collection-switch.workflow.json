{
  "version": "1.0.0",
  "canvas": ".principal-views/shared-collections/shared-collections.otel.canvas",
  "spanPattern": "shared.collection.switch",
  "name": "Collection Switch",
  "description": "Switch between collections when viewing shared collections",
  "scenarios": [
    {
      "id": "switch",
      "description": "User switches to a different collection",
      "priority": 1,
      "template": {
        "summary": "[Switch] From {{fromCollectionId}} to {{toCollectionId}}",
        "events": {
          "shared.collection.switch": "Switching from {{fromCollectionId}} to {{toCollectionId}}"
        }
      }
    }
  ]
}
