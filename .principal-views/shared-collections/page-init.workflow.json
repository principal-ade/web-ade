{
  "version": "1.0.0",
  "canvas": ".principal-views/shared-collections/shared-collections.otel.canvas",
  "spanPattern": "shared.page",
  "name": "Shared Collections Page Init",
  "description": "Initialize the shared collections page for viewing another user's collections",
  "scenarios": [
    {
      "id": "success-with-collections",
      "description": "User's collections load and viewer can browse them",
      "priority": 1,
      "template": {
        "summary": "[Success] Viewing {{username}}'s collections",
        "events": {
          "shared.page.init.started": "Loading shared collections for {{username}} (collection: {{collectionFromQuery}})",
          "shared.collections.fetch": "Fetching collections for {{username}}",
          "shared.collections.loaded": "Loaded {{collectionCount}} collections for {{username}}",
          "shared.permissions.check": "Checking permissions for {{username}} (authenticated: {{isAuthenticated}})",
          "shared.permissions.result": "Permissions: canEdit={{canEdit}}",
          "shared.collection.select": "Selected collection {{collectionId}} (source: {{source}})",
          "shared.page.ready": "Page ready: {{username}}/{{collectionId}} with {{repositoryCount}} repos (canEdit: {{canEdit}})"
        }
      }
    },
    {
      "id": "user-not-found",
      "description": "GitHub user doesn't exist",
      "priority": 2,
      "template": {
        "summary": "[Error] User {{username}} not found",
        "events": {
          "shared.page.init.started": "Loading shared collections for {{username}} (collection: {{collectionFromQuery}})",
          "shared.collections.fetch": "Fetching collections for {{username}}",
          "shared.user.not-found": "User {{username}} not found on GitHub"
        }
      }
    },
    {
      "id": "no-collections-repo",
      "description": "User exists but hasn't created collections yet",
      "priority": 3,
      "template": {
        "summary": "[Empty] {{username}} has no collections repo",
        "events": {
          "shared.page.init.started": "Loading shared collections for {{username}} (collection: {{collectionFromQuery}})",
          "shared.collections.fetch": "Fetching collections for {{username}}",
          "shared.collections.not-exists": "{{username}} hasn't shared any collections yet"
        }
      }
    },
    {
      "id": "empty-collections",
      "description": "User has collections repo but no collections in it",
      "priority": 4,
      "template": {
        "summary": "[Empty] {{username}}'s collections are empty",
        "events": {
          "shared.page.init.started": "Loading shared collections for {{username}} (collection: {{collectionFromQuery}})",
          "shared.collections.fetch": "Fetching collections for {{username}}",
          "shared.collections.loaded": "Loaded {{collectionCount}} collections for {{username}}",
          "shared.collections.empty": "{{username}}'s collections are empty"
        }
      }
    }
  ]
}
