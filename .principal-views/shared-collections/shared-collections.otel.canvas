{
  "name": "Shared Collections Page",
  "markdown": ".principal-views/shared-collections/shared-collections.md",
  "edgeTypes": {
    "flow": {
      "label": "Flow"
    },
    "error": {
      "label": "Error Path"
    },
    "user-action": {
      "label": "User Action"
    },
    "progressive": {
      "label": "Progressive Load"
    },
    "data-flow": {
      "label": "Data Flow"
    }
  },
  "nodes": [
    {
      "id": "page-init-started",
      "type": "otel-event",
      "x": -400,
      "y": 0,
      "width": 220,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "approved",
        "references": [
          "src/app/worlds/[username]/page.tsx"
        ]
      },
      "label": "Page Init Started",
      "event": {
        "name": "shared.page.init.started",
        "attributes": {
          "username": {
            "type": "string",
            "description": "Username from URL param",
            "required": true
          },
          "collectionFromQuery": {
            "type": "string",
            "description": "Collection ID from query param (if any)",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "fetch-collections",
      "type": "otel-event",
      "x": -400,
      "y": 150,
