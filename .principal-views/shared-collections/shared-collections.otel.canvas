  "nodes": [
    {
      "id": "page-init-started",
      "type": "text",
      "text": "# Page Init Started\n\nShared collections page loads for username",
      "x": -400,
      "y": 0,
      "width": 220,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "approved",
        "event": {
          "name": "shared.page.init.started",
          "attributes": {
            "username": {
              "type": "string",
              "description": "Username from URL param",
              "required": true
            },
            "collectionFromQuery": {
              "type": "string",
              "description": "Collection ID from query param (if any)",
              "required": false
            }
          }
        },
        "references": [
          "src/app/worlds/[username]/page.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": ["src/app/worlds/[username]/page.tsx"]
        }
      }
    },
