{
  "version": "1.0.0",
  "canvas": ".principal-views/worlds/worlds.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "worlds.mode",
  "name": "View Mode Switch",
  "description": "Switch between Manage and Explore modes on the Worlds page",
  "scenarios": [
    {
      "id": "switch-mode",
      "description": "User switches between Manage and Explore modes",
      "priority": 1,
      "template": {
        "summary": "[Mode] Switched from {fromMode} to {toMode}",
        "events": {
          "worlds.mode.switch": "Switching from {{fromMode}} to {{toMode}}"
        }
      }
    }
  ]
}
