{
  "version": "1.0.0",
  "canvas": ".principal-views/worlds/worlds.otel.canvas",
  "spanPattern": "worlds.page",
  "name": "Worlds Page Initialization",
  "description": "Initialize the Worlds page with authentication and collection loading",
  "scenarios": [
    {
      "id": "success-with-collections",
      "description": "Authenticated user with existing collections loads the page successfully",
      "priority": 1,
      "template": {
        "summary": "[Success] Page loaded with repos",
        "events": {
          "worlds.page.init.started": "Initializing Worlds page (urlCollectionId: {{urlCollectionId}})",
          "worlds.page.auth.check": "Auth check (isAuthenticated: {{isAuthenticated}})",
          "worlds.page.collections.load": "Loading collections for {{username}}",
          "worlds.page.collection.select": "Selected collection: {{collectionId}} (source: {{source}})",
          "worlds.page.init.success": "Page ready: {{collectionId}} with {{repositoryCount}} repos in {{viewMode}} mode"
        }
      }
    },
    {
      "id": "unauthenticated",
      "description": "Unauthenticated user sees login prompt",
      "priority": 2,
      "template": {
        "summary": "[Unauthenticated] Login required",
        "events": {
          "worlds.page.init.started": "Initializing Worlds page (urlCollectionId: {{urlCollectionId}})",
          "worlds.page.auth.check": "Auth check (isAuthenticated: {{isAuthenticated}})",
          "worlds.page.unauthenticated": "User not authenticated - showing login (redirect: {{redirectUrl}})"
        }
      }
    },
    {
      "id": "no-collections",
      "description": "Authenticated user with no collections sees create prompt",
      "priority": 3,
      "template": {
        "summary": "[Empty] No collections found",
        "events": {
          "worlds.page.init.started": "Initializing Worlds page (urlCollectionId: {{urlCollectionId}})",
          "worlds.page.auth.check": "Auth check (isAuthenticated: {{isAuthenticated}})",
          "worlds.page.collections.load": "Loading collections for {{username}}",
          "worlds.page.no-collections": "{{username}} has no collections - showing create prompt"
        }
      }
    },
    {
      "id": "error",
      "description": "Error occurred during page initialization",
      "priority": 4,
      "template": {
        "summary": "[Error] Page init failed",
        "events": {
          "worlds.page.init.started": "Initializing Worlds page (urlCollectionId: {{urlCollectionId}})",
          "worlds.page.auth.check": "Auth check (isAuthenticated: {{isAuthenticated}})",
          "worlds.page.collections.load": "Loading collections for {{username}}",
          "worlds.page.init.error": "Error: {{error.message}}"
        }
      }
    }
  ]
}
