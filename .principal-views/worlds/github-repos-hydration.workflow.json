{
  "version": "1.0.0",
  "canvas": ".principal-views/worlds/worlds.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "worlds.hydrate.github",
  "name": "GitHub Repos Hydration",
  "description": "Load user's GitHub repositories (owned, starred, orgs) for the Add Repository picker",
  "scenarios": [
    {
      "id": "success",
      "description": "Successfully loads all GitHub repo sources",
      "priority": 1,
      "template": {
        "summary": "[Success] {{ownedCount}} owned, {{starredCount}} starred, {{orgCount}} orgs",
        "events": {
          "worlds.hydrate.github-repos.start": "Fetching GitHub repos (authenticated: {{isAuthenticated}})",
          "worlds.hydrate.github-repos.success": "Loaded {{ownedCount}} owned, {{starredCount}} starred, {{orgCount}} orgs"
        }
      }
    }
  ]
}
