{
  "version": "1.0.0",
  "canvas": ".principal-views/worlds/worlds.otel.canvas",
  "spanPattern": "worlds.repository",
  "name": "Repository Selection",
  "description": "Select a repository from the overworld map to view in File City",
  "scenarios": [
    {
      "id": "success",
      "description": "User selects a repository and File City loads successfully",
      "priority": 1,
      "template": {
        "summary": "[Success] Loaded repo with {fileCount} files",
        "events": {
          "worlds.repository.select.started": "User clicked {{repositoryId}} in collection {{collectionId}}",
          "worlds.repository.file-tree.load": "Fetching file tree for {{repositoryId}}",
          "worlds.repository.select.success": "File City ready: {{repositoryId}} with {{fileCount}} files"
        }
      }
    },
    {
      "id": "error-file-tree",
      "description": "Failed to load repository file tree",
      "priority": 2,
      "template": {
        "summary": "[Error] Failed to load: {error.message}",
        "events": {
          "worlds.repository.select.started": "User clicked {{repositoryId}} in collection {{collectionId}}",
          "worlds.repository.file-tree.load": "Fetching file tree for {{repositoryId}}",
          "worlds.repository.select.error": "Failed to load {{repositoryId}}: {{error.message}}"
        }
      }
    },
    {
      "id": "deselect",
      "description": "User deselects current repository (clicks away)",
      "priority": 3,
      "template": {
        "summary": "[Deselected] Repository cleared",
        "events": {
          "worlds.repository.deselect": "User deselected (previous: {{previousRepositoryId}})"
        }
      }
    }
  ]
}
