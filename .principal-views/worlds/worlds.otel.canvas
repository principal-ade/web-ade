{
  "name": "Worlds Page Interactions",
  "markdown": ".principal-views/worlds/worlds.md",
  "edgeTypes": {
    "flow": {
      "label": "Flow"
    },
    "error": {
      "label": "Error Path"
    },
    "user-action": {
      "label": "User Action"
    },
    "progressive": {
      "label": "Progressive Load"
    },
    "data-flow": {
      "label": "Data Flow"
    }
  },
  "nodes": [
    {
      "id": "page-init-started",
      "type": "otel-event",
      "x": -400,
      "y": 0,
      "width": 200,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "approved",
        "references": [
          "src/app/worlds/page.tsx"
        ],
        "shape": "rectangle",
        "fill": "#22c55e",
        "stroke": "#16a34a"
      },
      "label": "Page Init Started",
      "event": {
        "name": "worlds.page.init.started",
        "attributes": {
          "urlCollectionId": {
            "type": "string",
            "description": "Collection ID from URL query param (if any)",
            "required": false
          }
        }
      },
      "otel": {
        "scope": "worlds-page",
        "status": "draft"
      }
    },
    {
      "id": "page-auth-check",
      "type": "otel-event",
      "x": -400,
      "y": 150,
      "width": 200,
      "height": 90,
      "color": "#1d4ed8",
      "pv": {
        "status": "approved",
        "references": [
          "src/app/worlds/page.tsx"
        ],
        "shape": "rectangle",
        "fill": "#3b82f6",
        "stroke": "#1d4ed8"
      },
      "label": "Auth Check",
      "event": {
        "name": "worlds.page.auth.check",
        "attributes": {
          "isAuthenticated": {
            "type": "boolean",
            "description": "Whether user is authenticated",
            "required": true
          }
        }
      },
      "otel": {
        "scope": "worlds-page",
        "status": "draft"
      }
    },
    {
      "id": "page-unauthenticated",
      "type": "otel-event",
      "x": -100,
      "y": 150,
      "width": 200,
      "height": 90,
      "color": "#d97706",
      "pv": {
        "status": "approved",
        "references": [
          "src/app/worlds/page.tsx"
