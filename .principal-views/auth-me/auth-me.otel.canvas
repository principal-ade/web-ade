{
  "name": "Get Current User (Auth Me)",
  "markdown": ".principal-views/auth-me/auth-me.md",
  "edgeTypes": {
    "flow": {
      "label": "Flow"
    },
    "error": {
      "label": "Error Path"
    },
    "external": {
      "label": "External Call"
    }
  },
  "nodes": [
    {
      "id": "http-request",
      "type": "otel-event",
      "x": 100,
      "y": 50,
      "width": 250,
      "height": 100,
      "pv": {
        "status": "approved",
        "references": [
          "src/app/api/auth/me/route.ts"
        ],
        "shape": "rectangle",
        "fill": "#dbeafe",
        "stroke": "#3b82f6"
      },
      "label": "GET /api/auth/me",
      "event": {
        "name": "http.request.start",
        "attributes": {
          "http.method": {
            "type": "string"
          },
          "http.route": {
            "type": "string"
          }
        }
      },
      "otel": {
        "scope": "authentication-api",
        "status": "draft"
      }
    },
    {
      "id": "get-token",
      "type": "otel-event",
      "x": 100,
      "y": 200,
      "width": 250,
      "height": 100,
      "pv": {
        "status": "implemented",
        "references": [
          "src/app/api/auth/me/route.ts"
        ],
        "shape": "rectangle",
        "fill": "#fef3c7",
        "stroke": "#f59e0b"
      },
      "label": "Get GitHub Token",
      "event": {
        "name": "auth.me.get_token",
        "attributes": {
          "has_token": {
            "type": "boolean"
          }
        }
      },
      "otel": {
        "scope": "authentication-api",
        "status": "draft"
      }
    },
    {
      "id": "fetch-github-user",
      "type": "otel-event",
      "x": 100,
      "y": 350,
      "width": 250,
      "height": 100,
      "pv": {
        "status": "implemented",
        "references": [
          "src/app/api/auth/me/route.ts"
        ],
        "shape": "rectangle",
        "fill": "#ede9fe",
        "stroke": "#8b5cf6"
      },
      "label": "Fetch GitHub User",
      "event": {
        "name": "auth.me.fetch_github",
        "attributes": {
          "response.status": {
            "type": "number"
          }
        }
      },
      "otel": {
        "scope": "authentication-api",
        "status": "draft"
      }
    },
    {
      "id": "sync-token",
      "type": "otel-event",
      "x": 450,
      "y": 350,
      "width": 220,
      "height": 100,
      "pv": {
        "status": "implemented",
        "references": [
          "src/app/api/auth/me/route.ts"
        ],
        "shape": "rectangle",
        "fill": "#fef3c7",
        "stroke": "#f59e0b"
      },
      "label": "Sync Token",
      "event": {
        "name": "auth.me.sync_token",
        "attributes": {
          "synced": {
            "type": "boolean"
          }
        }
      },
      "otel": {
        "scope": "authentication-api",
        "status": "draft"
      }
    },
    {
      "id": "return-user",
      "type": "otel-event",
      "x": 100,
      "y": 500,
      "width": 250,
      "height": 100,
      "pv": {
        "status": "implemented",
        "references": [
          "src/app/api/auth/me/route.ts"
        ],
        "shape": "rectangle",
        "fill": "#d1fae5",
        "stroke": "#22c55e",
        "dataSchema": {
          "isAuthenticated": {
            "type": "boolean",
            "required": true,
            "description": "Field value",
            "placeholder": "true/false"
          },
          "user.login": {
            "type": "string",
            "required": true,
            "description": "Field value",
            "placeholder": "value"
          },
          "user.id": {
            "type": "number",
            "required": true,
            "description": "Field value",
            "placeholder": "0"
          }
        }
      },
      "label": "Return User Data",
      "event": {
        "name": "auth.me.success",
        "attributes": {
          "user.login": {
            "type": "string"
          },
          "user.id": {
            "type": "number"
          }
        }
      },
      "otel": {
        "scope": "authentication-api",
        "status": "draft"
      }
    },
    {
      "id": "unauthenticated",
      "type": "otel-event",
      "x": 450,
      "y": 200,
      "width": 220,
      "height": 100,
      "pv": {
        "status": "implemented",
        "references": [
          "src/app/api/auth/me/route.ts"
        ],
        "shape": "rectangle",
        "fill": "#fee2e2",
        "stroke": "#ef4444"
      },
      "label": "Not Authenticated",
      "event": {
        "name": "auth.me.unauthenticated",
        "attributes": {
          "reason": {
            "type": "string"
          }
        }
      },
      "otel": {
        "scope": "authentication-api",
        "status": "draft"
      }
    },
    {
      "id": "error",
      "type": "otel-event",
      "x": 450,
      "y": 500,
      "width": 220,
      "height": 100,
      "pv": {
        "status": "implemented",
        "references": [
          "src/app/api/auth/me/route.ts"
        ],
        "shape": "rectangle",
        "fill": "#fee2e2",
        "stroke": "#ef4444",
        "dataSchema": {
          "error.type": {
            "type": "string",
            "required": true,
            "description": "Field value",
            "placeholder": "value"
          },
          "error.message": {
            "type": "string",
            "required": true,
            "description": "Field value",
            "placeholder": "value"
          }
        }
      },
      "label": "Error",
      "event": {
        "name": "auth.me.error",
        "attributes": {
          "error.type": {
            "type": "string"
          },
          "error.message": {
            "type": "string"
          }
        }
      },
      "otel": {
        "scope": "authentication-api",
        "status": "draft"
      }
    }
  ],
  "edges": [
    {
      "id": "request-to-token",
      "fromNode": "http-request",
      "fromSide": "bottom",
      "toNode": "get-token",
      "toSide": "top",
      "label": "1. get token",
      "edgeType": "flow"
    },
    {
      "id": "token-to-unauth",
      "fromNode": "get-token",
      "fromSide": "right",
      "toNode": "unauthenticated",
      "toSide": "left",
      "label": "no token",
      "edgeType": "error"
    },
    {
      "id": "token-to-github",
      "fromNode": "get-token",
      "fromSide": "bottom",
      "toNode": "fetch-github-user",
      "toSide": "top",
      "label": "2. has token",
      "edgeType": "flow"
    },
    {
      "id": "github-to-sync",
      "fromNode": "fetch-github-user",
      "fromSide": "right",
      "toNode": "sync-token",
      "toSide": "left",
      "label": "3. optional sync",
      "edgeType": "external"
    },
    {
      "id": "github-to-user",
      "fromNode": "fetch-github-user",
      "fromSide": "bottom",
      "toNode": "return-user",
      "toSide": "top",
      "label": "4. success",
      "edgeType": "flow"
    },
    {
      "id": "sync-to-user",
      "fromNode": "sync-token",
      "fromSide": "bottom",
      "toNode": "return-user",
      "toSide": "right",
      "edgeType": "flow"
    },
    {
      "id": "github-to-error",
      "fromNode": "fetch-github-user",
      "fromSide": "right",
      "toNode": "error",
      "toSide": "top",
      "label": "API error",
      "edgeType": "error"
    }
  ]
}
