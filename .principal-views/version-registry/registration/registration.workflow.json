{
  "version": "1.0.0",
  "canvas": ".principal-views/version-registry/version-registry.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.version-registry.register",
  "name": "Version Registration",
  "description": "Register a new version-to-commit mapping for deployment tracking",
  "scenarios": [
    {
      "id": "success-with-schematic",
      "description": "Successfully registered version mapping and fetched schematic from GitHub",
      "priority": 1,
      "template": {
        "summary": "[Success] Registered {service.name}@{version} → {git.sha} with schematic (completed in {duration.ms}ms)",
        "events": {
          "version.registration.started": "Version registration request received",
          "version.registration.validated": "Validated request for {{customer.id}}/{{service.name}}@{{version}}",
          "version.registration.s3.stored": "Stored mapping to {{s3.bucket}}/{{s3.key}}",
          "version.registration.schematic.fetching": "Fetching schematic from {{repository.url}} at {{git.sha}}",
          "version.registration.schematic.fetched": "Schematic fetched successfully ({{schematic.size}} bytes)",
          "version.registration.schematic.stored": "Schematic stored to {{s3.bucket}}/{{schematic.key}}",
          "version.registration.complete": "Registration completed → {{registration.id}} (schematic: {{schematic.id}})"
        }
      }
    },
    {
      "id": "success-no-schematic",
      "description": "Successfully registered version mapping without schematic (repo has no .principal-views)",
      "priority": 2,
      "template": {
        "summary": "[Success] Registered {service.name}@{version} → {git.sha} (no schematic)",
        "events": {
          "version.registration.started": "Version registration request received",
          "version.registration.validated": "Validated request for {{customer.id}}/{{service.name}}@{{version}}",
          "version.registration.s3.stored": "Stored mapping to {{s3.bucket}}/{{s3.key}}",
          "version.registration.complete-no-schematic": "Registration completed → {{registration.id}} (no schematic)"
        }
      }
    },
    {
      "id": "error-schematic",
      "description": "Version mapping stored successfully but schematic fetch failed (partial success)",
      "priority": 3,
      "template": {
        "summary": "[Warning] Registered {service.name}@{version} but schematic fetch failed: {error.message}",
        "events": {
          "version.registration.started": "Version registration request received",
          "version.registration.validated": "Validation passed for {{customer.id}}/{{service.name}}",
          "version.registration.s3.stored": "Version mapping stored to S3",
          "version.registration.schematic.fetching": "Attempting to fetch schematic from {{repository.url}}",
          "version.registration.schematic-error": "Schematic fetch failed ({{error.type}}): {{error.message}} - version mapping still valid"
        }
      }
    },
    {
      "id": "error",
      "description": "Registration failed due to validation or storage error",
      "priority": 4,
      "template": {
        "summary": "[Error] Registration failed: {error.message}",
        "events": {
          "version.registration.started": "Version registration request received",
          "version.registration.error": "Error at {{error.stage}} ({{error.type}}): {{error.message}}"
        }
      }
    }
  ]
}
