{
  "version": "1.0.0",
  "canvas": ".principal-views/version-registry/version-registry.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.version-registry.lookup",
  "name": "Version Lookup",
  "description": "Look up git commit SHA for a registered version",
  "scenarios": [
    {
      "id": "lookup-success",
      "description": "Successfully retrieved the git commit SHA for the requested version",
      "priority": 1,
      "template": {
        "summary": "[Success] Found {service.name}@{version} → {git.sha} (completed in {duration.ms}ms)",
        "events": {
          "version.lookup.started": "Version lookup for {{customer.id}}/{{service.name}}@{{version}} ({{environment}})",
          "version.lookup.s3.retrieved": "Retrieved mapping from {{s3.key}} (SHA: {{git.sha}}, repo: {{repository.url}}, deployed: {{deployed.at}})",
          "version.lookup.complete": "Lookup complete → {{git.sha}} ({{duration.ms}}ms)"
        }
      }
    },
    {
      "id": "lookup-not-found",
      "description": "Lookup completed but the version has not been registered",
      "priority": 2,
      "template": {
        "summary": "[Not Found] Version {service.name}@{version} not registered",
        "events": {
          "version.lookup.started": "Version lookup for {{customer.id}}/{{service.name}}@{{version}} ({{environment}})",
          "version.lookup.not_found": "{{customer.id}}/{{service.name}}@{{version}} not registered"
        }
      }
    },
    {
      "id": "lookup-error",
      "description": "Lookup operation failed due to storage, validation, or unexpected error",
      "priority": 3,
      "template": {
        "summary": "[Error] Lookup failed: {error.message}",
        "events": {
          "version.lookup.started": "Version lookup for {{customer.id}}/{{service.name}}@{{version}} ({{environment}})",
          "version.lookup.error": "Error at {{error.stage}} ({{error.type}}): {{error.message}}"
        }
      }
    }
  ]
}
