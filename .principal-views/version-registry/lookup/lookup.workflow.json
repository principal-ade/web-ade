{
  "version": "1.0.0",
  "canvas": ".principal-views/version-registry/version-registry.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.version-registry.lookup",
  "name": "Version Lookup",
  "description": "Look up git commit SHA for a registered version",
  "scenarios": [
    {
      "id": "lookup-success",
      "description": "Successfully retrieved the git commit SHA for the requested version",
      "priority": 1,
      "template": {
        "summary": "[Success] Found {service.name}@{version} → {git.sha} (completed in {duration.ms}ms)",
        "events": {
          "version.lookup.started": "Version lookup request received",
          "version.lookup.s3.retrieved": "Retrieved mapping from {{s3.key}} (SHA: {{git.sha}}, deployed: {{deployed.at}})",
          "version.lookup.complete": "Lookup complete → {{git.sha}}"
        }
      }
    },
    {
      "id": "lookup-not-found",
      "description": "Lookup completed but the version has not been registered",
      "priority": 2,
      "template": {
        "summary": "[Not Found] Version {service.name}@{version} not registered",
        "events": {
          "version.lookup.started": "Version lookup request received",
          "version.lookup.not_found": "Version not registered - deployment gate will reject traces from this version"
        }
      }
    },
    {
      "id": "lookup-storage-error",
      "description": "Lookup operation failed due to an S3 storage error",
      "priority": 3,
      "template": {
        "summary": "[Error] S3 lookup failed: {error.message}",
        "events": {
          "version.lookup.started": "Version lookup request received",
          "version.lookup.error": "S3 storage error ({{error.type}}): {{error.message}}"
        }
      }
    },
    {
      "id": "lookup-validation-error",
      "description": "Lookup operation failed due to invalid request parameters",
      "priority": 4,
      "template": {
        "summary": "[Error] Lookup validation failed: {error.message}",
        "events": {
          "version.lookup.started": "Version lookup request received",
          "version.lookup.error": "Validation failed ({{error.type}}): {{error.message}}"
        }
      }
    },
    {
      "id": "lookup-generic-error",
      "description": "Lookup operation failed due to an unexpected error",
      "priority": 5,
      "template": {
        "summary": "[Error] Lookup failed: {error.message}",
        "events": {
          "version.lookup.started": "Version lookup request received",
          "version.lookup.error": "Error at {{error.stage}} ({{error.type}}): {{error.message}}"
        }
      }
    }
  ]
}
