{
  "version": "1.0.0",
  "canvas": ".principal-views/version-registry/version-registry.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "api.version-registry.list",
  "name": "Version List",
  "description": "List all registered versions for a repository",
  "scenarios": [
    {
      "id": "list-success",
      "priority": 1,
      "template": {
        "summary": "✅ Listed {registration.count} version(s) for {customer.id} (completed in {duration.ms}ms)",
        "events": {
          "version.list.started": "Version list request received",
          "version.list.s3.retrieved": "Retrieved {{registration.count}} registration(s) from S3",
          "version.list.complete": "List complete with {{registration.count}} version(s)"
        }
      }
    },
    {
      "id": "list-success-empty",
      "priority": 2,
      "template": {
        "summary": "✅ No versions registered for {customer.id}",
        "events": {
          "version.list.started": "Version list request received",
          "version.list.s3.retrieved": "No registrations found in S3",
          "version.list.complete": "List complete - repository has no registered versions"
        }
      }
    },
    {
      "id": "list-storage-error",
      "priority": 3,
      "template": {
        "summary": "❌ S3 list failed for {customer.id}: {error.message}",
        "events": {
          "version.list.started": "Version list request received",
          "version.list.error": "S3 storage error ({{error.type}}): {{error.message}}"
        }
      }
    },
    {
      "id": "list-validation-error",
      "priority": 4,
      "template": {
        "summary": "❌ List validation failed: {error.message}",
        "events": {
          "version.list.started": "Version list request received",
          "version.list.error": "Validation failed ({{error.type}}): {{error.message}}"
        }
      }
    },
    {
      "id": "list-generic-error",
      "priority": 5,
      "template": {
        "summary": "❌ List failed for {customer.id}: {error.message}",
        "events": {
          "version.list.started": "Version list request received",
          "version.list.error": "Error at {{error.stage}} ({{error.type}}): {{error.message}}"
        }
      }
    }
  ]
}
