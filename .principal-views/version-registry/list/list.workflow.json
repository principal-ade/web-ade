{
  "version": "1.0.0",
  "canvas": ".principal-views/version-registry/version-registry.otel.canvas",
  "spanPattern": "api.version-registry.list",
  "name": "Version List",
  "description": "List all registered versions for a repository",
  "scenarios": [
    {
      "id": "list-success",
      "description": "Successfully retrieved a list of registered versions from S3 (may be empty)",
      "priority": 1,
      "template": {
        "summary": "[Success] Listed {{registration.count}} version(s) for {{customer.id}}",
        "events": {
          "version.list.started": "Version list request for {{customer.id}}",
          "version.list.s3.retrieved": "Retrieved {{registration.count}} registration(s) from S3 for {{customer.id}}",
          "version.list.complete": "List complete for {{customer.id}} with {{registration.count}} version(s)"
        }
      }
    },
    {
      "id": "list-error",
      "description": "List operation failed due to storage, validation, or unexpected error",
      "priority": 3,
      "template": {
        "summary": "[Error] List failed for {customer.id}: {error.message}",
        "events": {
          "version.list.started": "Version list request for {{customer.id}}",
          "version.list.error": "Error at {{error.stage}} ({{error.type}}): {{error.message}}"
        }
      }
    }
  ]
}
