  ],
  "edges": [
    {
      "id": "init-1",
      "fromNode": "feed-init-started",
      "fromSide": "bottom",
      "toNode": "feed-fetch-batch",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "init-2",
      "fromNode": "feed-fetch-batch",
      "fromSide": "bottom",
      "toNode": "feed-fetch-repo-item",
      "toSide": "top",
      "label": "per repo",
      "edgeType": "flow"
    },
    {
      "id": "init-3",
      "fromNode": "feed-fetch-batch",
      "fromSide": "right",
      "toNode": "feed-fetch-repo-error",
      "toSide": "left",
      "edgeType": "error"
    },
    {
      "id": "init-4",
      "fromNode": "feed-fetch-batch",
      "fromSide": "right",
      "toNode": "feed-init-error",
      "toSide": "left",
      "edgeType": "error"
    },
    {
      "id": "init-5",
      "fromNode": "feed-fetch-repo-item",
      "fromSide": "bottom",
      "toNode": "feed-init-success",
      "toSide": "top",
      "label": "all loaded",
      "edgeType": "flow"
    },
    {
      "id": "init-6",
      "fromNode": "feed-fetch-repo-item",
      "fromSide": "right",
      "toNode": "feed-init-empty",
      "toSide": "left",
      "label": "no commits",
      "edgeType": "conditional"
    },
    {
      "id": "refresh-1",
      "fromNode": "feed-visibility-change",
      "fromSide": "bottom",
      "toNode": "feed-refresh-started",
      "toSide": "top",
      "label": "visible",
      "edgeType": "flow"
    },
    {
      "id": "refresh-2",
      "fromNode": "feed-refresh-started",
      "fromSide": "bottom",
      "toNode": "feed-refresh-complete",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "refresh-3",
      "fromNode": "feed-refresh-started",
      "fromSide": "right",
      "toNode": "feed-fetch-batch",
      "toSide": "left",
      "label": "triggers",
      "edgeType": "data-flow"
    },
    {
      "id": "mobile-1",
      "fromNode": "feed-init-success",
      "fromSide": "bottom",
      "toNode": "mobile-card-swipe",
      "toSide": "top",
      "label": "mobile UI",
      "edgeType": "user-action"
    },
    {
      "id": "mobile-2",
      "fromNode": "mobile-card-swipe",
      "fromSide": "bottom",
      "toNode": "mobile-commit-swipe",
      "toSide": "top",
      "edgeType": "user-action"
    },
    {
      "id": "mobile-3",
