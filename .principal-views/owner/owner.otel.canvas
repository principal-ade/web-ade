            "type": "number",
            "description": "Number of repositories",
            "required": true
          },
          "ownerInfo": {
            "type": "object",
            "description": "Owner metadata",
            "required": false,
            "display": false
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
