{
  "name": "Owner Page",
  "markdown": ".principal-views/owner/owner.md",
  "edgeTypes": {
    "flow": {
      "label": "Flow"
    },
    "error": {
      "label": "Error Path"
    },
    "user-action": {
      "label": "User Action"
    },
    "data-flow": {
      "label": "Data Flow"
    }
  },
  "nodes": [
    {
      "id": "page-init",
      "type": "otel-event",
      "x": -400,
      "y": 0,
      "width": 200,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "approved",
        "references": [
          "src/app/[owner]/page.tsx"
        ]
      },
      "label": "Page Init",
      "event": {
        "name": "owner.page.init",
        "attributes": {
          "owner": {
            "type": "string",
            "description": "GitHub owner (user/org)",
            "required": true
          },
          "project": {
            "type": "string",
            "description": "Initial project from URL query",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "owner-repos-load",
      "type": "otel-event",
      "x": -400,
      "y": 150,
      "width": 200,
      "height": 90,
      "color": "#6d28d9",
      "pv": {
        "status": "approved",
        "references": [
          "src/contexts/OwnerPageProvider.tsx"
        ]
      },
      "label": "Load Repositories",
      "event": {
        "name": "owner.repos.load",
        "attributes": {
          "owner": {
            "type": "string",
            "description": "GitHub owner",
            "required": true
