{
  "pv": {
    "name": "Repository Page",
    "version": "1.0.0",
    "markdown": ".principal-views/repository/repository.md",
    "edgeTypes": {
      "flow": {
        "label": "Flow"
      },
      "error": {
        "label": "Error Path"
      },
      "user-action": {
        "label": "User Action"
      },
      "data-flow": {
        "label": "Data Flow"
      }
    }
  },
  "nodes": [
    {
      "id": "page-init",
      "type": "otel-event",
      "x": -400,
      "y": 0,
      "width": 200,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "approved",
        "references": [
          "src/app/[owner]/[repo]/page.tsx"
        ]
      },
      "label": "Page Init",
      "event": {
        "name": "repo.page.init",
        "attributes": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "configId": {
            "type": "string",
            "description": "Initial layout config",
            "required": false
          }
        }
      }
    },
    {
      "id": "file-tree-load",
      "type": "otel-event",
      "x": -400,
      "y": 150,
      "width": 200,
      "height": 90,
      "color": "#6d28d9",
      "pv": {
        "status": "approved",
        "references": [
          "src/contexts/RepositoryPageProvider.tsx"
        ]
      },
      "label": "Load File Tree",
      "event": {
        "name": "repo.file-tree.load",
        "attributes": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          }
        }
      }
    },
    {
      "id": "file-tree-success",
      "type": "otel-event",
      "x": -400,
      "y": 425,
      "width": 200,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "approved",
        "references": [
          "src/contexts/RepositoryPageProvider.tsx"
        ]
      },
      "label": "File Tree Ready",
      "event": {
        "name": "repo.file-tree.success",
        "attributes": {
          "fileCount": {
            "type": "number",
            "description": "Number of files in tree",
            "required": true
          },
          "treeSha": {
            "type": "string",
            "description": "Git tree SHA",
            "required": false
          }
        }
      }
    },
    {
      "id": "file-tree-error",
      "type": "otel-event",
      "x": -150,
      "y": 150,
      "width": 200,
      "height": 90,
      "color": "#dc2626",
      "pv": {
        "status": "approved",
        "references": [
          "src/contexts/RepositoryPageProvider.tsx"
        ]
      },
      "label": "File Tree Error",
      "event": {
        "name": "repo.file-tree.error",
        "attributes": {
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          }
        }
      }
    },
    {
      "id": "file-tree-cache-hit",
      "type": "otel-event",
      "x": -461,
      "y": 297,
      "width": 200,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "implemented",
        "references": [
          "src/server/routers/github.ts"
        ]
      },
      "label": "Cache Hit",
      "event": {
        "name": "repo.file-tree.cache.hit",
        "attributes": {
          "cache.key": {
            "type": "string",
            "description": "Cache key (owner/repo/sha)",
            "required": true
          },
          "tree.sha": {
            "type": "string",
            "description": "Git tree SHA",
            "required": true
          },
          "tree.fileCount": {
            "type": "number",
            "description": "Number of files in tree",
            "required": true
          },
          "cache.hit": {
            "type": "boolean",
            "description": "Always true for cache hit",
            "required": true
          },
          "durationMs": {
            "type": "number",
            "description": "Time to retrieve from cache",
            "required": true
          }
        }
      }
    },
    {
      "id": "file-tree-cache-miss",
      "type": "otel-event",
      "x": -158,
      "y": 278,
      "width": 200,
      "height": 90,
      "color": "#ca8a04",
      "pv": {
        "status": "implemented",
        "references": [
          "src/server/routers/github.ts"
        ]
      },
      "label": "Cache Miss",
      "event": {
        "name": "repo.file-tree.cache.miss",
        "attributes": {
          "cache.key": {
            "type": "string",
            "description": "Cache key (owner/repo/sha)",
            "required": true
          },
          "cache.hit": {
            "type": "boolean",
            "description": "Always false for cache miss",
            "required": true
          }
        }
      }
    },
    {
      "id": "file-tree-fetch-complete",
      "type": "otel-event",
      "x": -133,
      "y": 400,
      "width": 200,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "implemented",
        "references": [
          "src/server/routers/github.ts"
        ]
      },
      "label": "Fetch Complete",
      "event": {
        "name": "repo.file-tree.fetch.complete",
        "attributes": {
          "tree.sha": {
            "type": "string",
            "description": "Git tree SHA",
            "required": true
          },
          "tree.fileCount": {
            "type": "number",
            "description": "Number of files in tree",
            "required": true
          },
          "tree.truncated": {
            "type": "boolean",
            "description": "Whether tree was truncated",
            "required": true
          },
          "durationMs": {
            "type": "number",
            "description": "Time to fetch from GitHub",
            "required": true
          }
        }
      }
    },
