  "nodes": [
    {
      "id": "page-init",
      "type": "text",
      "text": "# Page Init\n\nRepository page loads",
      "x": -400,
      "y": 0,
      "width": 200,
      "height": 90,
      "color": "#16a34a",
      "pv": {
        "status": "approved",
        "event": {
          "name": "repo.page.init",
          "attributes": {
            "owner": {
              "type": "string",
              "description": "Repository owner",
              "required": true
            },
            "repo": {
              "type": "string",
              "description": "Repository name",
              "required": true
            },
            "configId": {
              "type": "string",
              "description": "Initial layout config",
              "required": false
            }
          }
        },
        "references": [
          "src/app/[owner]/[repo]/page.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": ["src/app/[owner]/[repo]/page.tsx"]
        }
      }
    },
