{
  "version": "1.0.0",
  "canvas": ".principal-views/repository/repository.otel.canvas",
  "spanPattern": "repo.panel.markdown.render",
  "name": "Overview Layout",
  "description": "Overview layout shows README/markdown with File City and packages",
  "scenarios": [
    {
      "id": "readme-view",
      "description": "Page loads, README auto-loads and renders in markdown panel",
      "priority": 1,
      "template": {
        "summary": "[Overview] README displayed for {{owner}}/{{repo}}",
        "events": {
          "repo.page.init": "Page initialized: {{owner}}/{{repo}} (config: {{configId}})",
          "repo.readme.auto-load": "README found: {{found}} ({{path}})",
          "repo.file.content.load": "Loading content for {{filePath}}",
          "repo.file.content.success": "Content loaded: {{filePath}} ({{contentLength}} bytes)",
          "repo.state.active-file.updated": "Active file: {{filePath}}",
          "repo.panel.markdown.render": "Markdown rendered: {{filePath}} ({{contentLength}} bytes)"
        }
      }
    },
    {
      "id": "markdown-file-view",
      "description": "User selects a markdown file from File City",
      "priority": 2,
      "template": {
        "summary": "[Overview] Viewing {{filePath}}",
        "events": {
          "repo.file.select": "File selected: {{filePath}}",
          "repo.file.content.load": "Loading content for {{filePath}}",
          "repo.file.content.success": "Content loaded: {{filePath}} ({{contentLength}} bytes)",
          "repo.state.active-file.updated": "Active file: {{filePath}}",
          "repo.panel.markdown.render": "Markdown rendered: {{filePath}} ({{contentLength}} bytes)"
        }
      }
    }
  ]
}
