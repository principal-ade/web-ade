{
  "version": "1.0.0",
  "canvas": ".principal-views/repository/repository.otel.canvas",
  "mode": "span-tree",
  "spanPattern": "repo.page.init",
  "name": "Page Initialization",
  "description": "Repository page loads and initiates parallel data fetching",
  "scenarios": [
    {
      "id": "page-load-cache-hit",
      "description": "Page loads with file tree served from cache (fast path)",
      "priority": 1,
      "template": {
        "summary": "[Init] {{owner}}/{{repo}} loaded (cached)",
        "events": {
          "repo.page.init": "Repository page initialized: {{owner}}/{{repo}} (config: {{configId}})",
          "repo.file-tree.load": "Loading file tree for {{owner}}/{{repo}}",
          "repo.file-tree.cache.hit": "Cache hit: {{tree.fileCount}} files in {{durationMs}}ms (key: {{cache.key}}, sha: {{tree.sha}}, cached: {{cache.hit}})",
          "repo.packages.load": "Loading packages for {{owner}}/{{repo}}",
          "repo.file-tree.success": "File tree loaded: {{fileCount}} files (sha: {{treeSha}})",
          "repo.packages.success": "Packages loaded: {{packageCount}} packages (monorepo: {{isMonorepo}})",
          "repo.readme.auto-load": "Auto-loading README: {{found}} ({{path}})"
        }
      }
    },
    {
      "id": "page-load-cache-miss",
      "description": "Page loads with file tree fetched from GitHub (cache miss)",
      "priority": 2,
      "template": {
        "summary": "[Init] {{owner}}/{{repo}} loaded (fetched)",
        "events": {
          "repo.page.init": "Repository page initialized: {{owner}}/{{repo}} (config: {{configId}})",
          "repo.file-tree.load": "Loading file tree for {{owner}}/{{repo}}",
          "repo.file-tree.cache.miss": "Cache miss: fetching from GitHub (key: {{cache.key}}, cached: {{cache.hit}})",
          "repo.file-tree.fetch.complete": "Fetched {{tree.fileCount}} files in {{durationMs}}ms (sha: {{tree.sha}}, truncated: {{tree.truncated}})",
          "repo.packages.load": "Loading packages for {{owner}}/{{repo}}",
          "repo.file-tree.success": "File tree loaded: {{fileCount}} files (sha: {{treeSha}})",
          "repo.packages.success": "Packages loaded: {{packageCount}} packages (monorepo: {{isMonorepo}})",
          "repo.readme.auto-load": "Auto-loading README: {{found}} ({{path}})"
        }
      }
    },
    {
      "id": "file-tree-error",
      "description": "File tree fails to load (repo may be empty or inaccessible)",
      "priority": 3,
      "template": {
        "summary": "[Init] File tree error for {{owner}}/{{repo}}",
        "events": {
          "repo.page.init": "Repository page initialized: {{owner}}/{{repo}} (config: {{configId}})",
          "repo.file-tree.load": "Loading file tree for {{owner}}/{{repo}}",
          "repo.file-tree.error": "Failed to load file tree: {{error.message}}"
        }
      }
    },
    {
      "id": "packages-error",
      "description": "Packages fail to load (no package.json, API error)",
      "priority": 4,
      "template": {
        "summary": "[Init] Packages error for {{owner}}/{{repo}}",
        "events": {
          "repo.page.init": "Repository page initialized: {{owner}}/{{repo}} (config: {{configId}})",
          "repo.packages.load": "Loading packages for {{owner}}/{{repo}}",
          "repo.packages.error": "Failed to load packages: {{error.message}}"
        }
      }
    }
  ]
}
