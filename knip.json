{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "src/lib/**/*.{ts,tsx}",
    "src/contexts/**/*.{ts,tsx}",
    "src/hooks/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "ignore": [
    "**/*.stories.tsx",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    ".storybook/**",
    "coverage/**",
    ".next/**"
  ],
  "ignoreDependencies": [
    "@monaco-editor/react",
    "eslint-config-next",
    "tailwindcss"
  ]
}
