# Authentication Configuration
# Landing page auth server URL
LANDING_PAGE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Auth server URL for token refresh
AUTH_SERVER_URL=http://localhost:3000

# Session encryption (generate a random 32+ character string)
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=generate-your-own-secret-here

# Messaging server
MESSAGING_SERVER_URL=http://localhost:3001

# AI API Keys
# Google AI API key for Gemini models
# Get one at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# GitHub PAT for public repo access (unauthenticated users)
# Create a fine-grained PAT with read-only access to public repos
# Required scopes: actions:read (for downloading artifacts)
GITHUB_PUBLIC_PAT=

# Environment
NODE_ENV=development

# Google Analytics
# Google Analytics 4 Measurement ID for tracking page views and events
# Get from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Text-to-Speech Configuration
# ElevenLabs API key for text-to-speech generation
# Get one at: https://elevenlabs.io (Profile → API Keys)
# Plans: Free (10K chars/mo), Creator $22/mo (100K chars)
ELEVENLABS_API_KEY=

# ElevenLabs voice ID (default: Rachel - 21m00Tcm4TlvDq8ikWAM)
# Browse voices at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ElevenLabs model (eleven_turbo_v2 recommended for speed/cost)
# Options: eleven_turbo_v2 (fast/cheap), eleven_monolingual_v1 (high quality)
ELEVENLABS_MODEL_ID=eleven_turbo_v2

# AWS S3 Configuration for TTS Audio Caching
# AWS credentials are auto-detected from Amplify IAM role
# Note: Cannot use AWS_ prefix in Amplify (reserved by AWS)
TTS_AWS_REGION=us-east-1
TTS_S3_BUCKET=repo-tour-audio

# Optional: CDN domain for serving TTS audio (e.g., CloudFront)
# If not set, audio will be served directly from S3
CDN_DOMAIN=

# Version Registry Configuration
# S3 bucket for storing version-to-commit mappings
# Used for contract-based observability platform
VERSION_REGISTRY_S3_BUCKET=principal-schematic-registry
VERSION_REGISTRY_AWS_REGION=us-east-1
