# Authentication Configuration
# Landing page auth server URL
LANDING_PAGE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Auth server URL for token refresh
AUTH_SERVER_URL=http://localhost:3000

# Session encryption (generate a random 32+ character string)
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=generate-your-own-secret-here

# Messaging server
MESSAGING_SERVER_URL=http://localhost:3001

# AI API Keys
# Google AI API key for Gemini models
# Get one at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# GitHub PAT for public repo access (unauthenticated users)
# Create a fine-grained PAT with read-only access to public repos
# Required scopes: actions:read (for downloading artifacts)
GITHUB_PUBLIC_PAT=

# Environment
NODE_ENV=development

# Google Analytics
# Google Analytics 4 Measurement ID for tracking page views and events
# Get from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
